# =========================================================================
# WTCMessenger - Modelo de Configuração (.env)
# =========================================================================
# Renomeie este arquivo para '.env' na raiz do backend antes de executar:
# docker compose up --build -d
# =========================================================================

# 🔐 JWT Configuration (Segurança & Autenticação)
# Use uma chave robusta em Base64 (mínimo de 32 bytes).
# Dica de geração no Terminal: openssl rand -base64 32
JWT_SECRET=seu_secret_base64_aqui

# 🍃 MongoDB Configuration (Banco de Dados NoSQL)
# Nuvem (Atlas): mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/wtcmessenger?retryWrites=true&w=majority
# Local (Contêiner): mongodb://localhost:27017/wtcmessenger
MONGODB_URI=sua_uri_do_mongodb_atlas_aqui

# 🤖 Google Gemini API Configuration (Inteligência Artificial)
# Obtenha sua chave gratuita em: https://aistudio.google.com/
# Necessária para o funcionamento do Copiloto de Campanhas (/campaigns/generate)
GEMINI_API_KEY=sua_chave_de_api_do_gemini_aqui
