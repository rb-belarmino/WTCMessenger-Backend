{
  "info": {
    "name": "WTC Messenger Microservices",
    "description": "Coleção de testes para o Auth Service e Messaging Service. Execute o '1. Login' para obter o Token e depois use nas requisições do Messaging Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "1. Login (Operator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set('wtc_jwt_token', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"operator@wtcmessenger.com\",\n    \"password\": \"operator123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Messaging Service",
      "item": [
        {
          "name": "2. Send Message (Kafka Queue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{wtc_jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"recipientId\": \"customer123\",\n    \"content\": \"Olá, seja bem-vindo ao WTC!\",\n    \"type\": \"TEXT\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/messages",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "messages"
              ]
            }
          }
        },
        {
          "name": "3. Customer 360 Timeline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{wtc_jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/customers/customer123/timeline",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "customers",
                "customer123",
                "timeline"
              ]
            }
          }
        },
        {
          "name": "4. Create Campaign (SwiftUI Payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{wtc_jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Nova Atualização ESG\",\n    \"body\": \"Acompanhe nossos resultados de sustentabilidade.\",\n    \"url\": \"https://wtcmessenger.com/assets/esg_banner.png\",\n    \"actions\": [\"Ver Relatório\", \"Ignorar\"],\n    \"actionUrls\": {\n        \"Ver Relatório\": \"wtcapp://esg/report/2026\"\n    }\n}"
            },
            "url": {
              "raw": "http://localhost:8082/campaigns",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "campaigns"
              ]
            }
          }
        }
      ]
    }
  ]
}
